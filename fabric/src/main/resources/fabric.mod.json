{
    "schemaVersion": 1,
    "id": "projectnublar",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "accessWidener": "projectnublar.accesswidener",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Dumb-Code/Project-Nublar",
        "issues": "https://github.com/Dumb-Code/Project-Nublar/issues",
        "sources": "https://github.com/Dumb-Code/Project-Nublar"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.dumbcode.projectnublar.ProjectNublarFabric"
        ],
        "client": [
            "net.dumbcode.projectnublar.ProjectNublarClientFabric"
        ]
    },
    "depends": {
        "java": ">=${java_version}",
        "minecraft": "~${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "geckolib": ">=${geckolib_fabric_version}",
        "smartbrainlib": ">=${sbl_version}",
        "balm": ">=${balm_version}",
        "architectury": ">=${architectury_api_version}"
    },
    "suggests": {
        "team_reborn_energy": "*"
    }
}

