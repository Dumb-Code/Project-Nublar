{
    "schemaVersion": 1,
    "id": "projectnublar",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "accessWidener": "projectnublar.accesswidener",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Dumb-Code/Project-Nublar",
        "issues": "https://github.com/Dumb-Code/Project-Nublar/issues",
        "sources": "https://github.com/Dumb-Code/Project-Nublar"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.dumbcode.projectnublar.ProjectNublarFabric"
        ],
        "fabric-gametest": [
            "net.dumbcode.projectnublar.gametest.FabricGameTests"
        ]
    },
    "mixins": [
        "projectnublar.mixins.json",
        "projectnublar.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "geckolib": ">=4.7",
        "smartbrainlib": ">=1.15",
        "architectury": ">=9.2"
    }
}
