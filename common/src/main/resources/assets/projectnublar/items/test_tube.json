{
  "model": {
    "type": "minecraft:select",
    "property": "projectnublar:test_tube_overlay",
    "cases": [
      {
        "when": "none",
        "model": {
          "type": "minecraft:model",
          "model": "projectnublar:item/test_tube/empty"
        }
      },
      {
        "when": "tyrannosaurus_rex",
        "model": {
          "type": "minecraft:model",
          "model": "projectnublar:item/test_tube/tyrannosaurus_rex"
        }
      },
      {
        "when": "triceratops",
        "model": {
          "type": "minecraft:model",
          "model": "projectnublar:item/test_tube/triceratops"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "projectnublar:item/test_tube/full"
    }
  }
}
